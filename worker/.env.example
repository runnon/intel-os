SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Comma-separated AORs to sweep (default: all six). Legacy single AOR also works.
AORS=CENTCOM,EUCOM,INDOPACOM,AFRICOM,NORTHCOM,SOUTHCOM

# --- Social layer (OPTIONAL, free, opt-in) -------------------------------------
# All social sources are an early-warning layer only: a social-only event is held
# unpublished until a news/official source corroborates it. Leave blank to disable
# (the NIPRNet build is unaffected). Mastodon hashtag RSS needs no credentials.
#
# Bluesky (AT Protocol public API) — free app password from bsky.app settings:
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Telegram (GramJS/MTProto) — free api_id/api_hash from https://my.telegram.org,
# plus a one-time StringSession (generate once by logging in), and public channels:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=

# --- X distribution (OPTIONAL, opt-in) ------------------------------------------
# After each cycle the worker composes one thread from the issues it published.
# Without X_POST_ENABLED=1 it only records the draft in x_posts (dry_run = true).
# OAuth 1.0a user-context keys from the X developer portal (app with Read + Write).
X_POST_ENABLED=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
